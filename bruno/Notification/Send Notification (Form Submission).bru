meta {
  name: Send Notification (Form Submission)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "clientId": "acme-corp",
    "type": "email",
    "recipients": ["sales@acme.com"],
    "subject": "New contact form submission",
    "emailTemplate": "form_submission",
    "fields": {
      "submission": {
        "name": "Jane Doe",
        "email": "jane@example.com",
        "message": "Looking for a quote on a new site."
      },
      "integrations": [
        {
          "name": "Mailchimp",
          "outcome": "succeeded",
          "url": "https://us1.admin.mailchimp.com/lists/members/view?id=123"
        },
        {
          "name": "Google Sheets",
          "outcome": "failed",
          "detail": "Spreadsheet permission denied"
        }
      ]
    },
    "cta": {
      "url": "mailto:jane@example.com",
      "label": "Reply to Jane Doe"
    },
    "context": {
      "formId": "6f1c3b7e-2a4d-4e8f-9b0c-1d2e3f4a5b6c",
      "submissionId": "3b2f6e1a-8c4d-4f7e-a9b0-c1d2e3f4a5b6"
    },
    "idempotencyKey": "3b2f6e1a-8c4d-4f7e-a9b0-c1d2e3f4a5b6:channel-1"
  }
}
