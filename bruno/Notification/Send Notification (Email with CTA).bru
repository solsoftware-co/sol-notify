meta {
  name: Send Notification (Email with CTA)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "clientId": "acme-corp",
    "type": "email",
    "recipients": ["sales@acme.com"],
    "subject": "New lead added to Mailchimp",
    "emailTemplate": "mailchimp_confirmation",
    "fields": {
      "email": "jane@example.com"
    },
    "cta": {
      "url": "https://us1.admin.mailchimp.com/lists/",
      "label": "View your audience"
    }
  }
}
